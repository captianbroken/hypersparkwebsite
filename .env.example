# EmailJS contact form settings (get these from https://dashboard.emailjs.com).
#
# Vite inlines VITE_* variables into the JavaScript bundle at BUILD time, so
# they must be set wherever `npm run build` runs (your machine, GitHub Actions
# secrets, or your host's build environment variables), not just at runtime.
#
# The Gmail / Google Workspace App Password belongs in the EmailJS dashboard
# (Email Services), never in this repository.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
